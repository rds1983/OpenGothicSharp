<Project>
  <Project.ExportOptions Namespace="OpenGothic.UI" Class="Controls" FieldsVisibility="Private" />
  <VerticalStackPanel Id="_panelRoot" Spacing="2" Background="#000000A6" Padding="10,6">
    <Label Id="_labelHeader" Text="Controls" TextColor="#FFCC66" />
    <Label Id="_labelMove" Text="WASD - Move" TextColor="#E8E8E8" />
    <Label Id="_labelLook" Text="Mouse - Look" TextColor="#E8E8E8" />
    <Label Id="_labelCamera" Text="F5 - First/third person" TextColor="#E8E8E8" />
    <Label Id="_labelEscape" Text="Escape - Exit" TextColor="#E8E8E8" />
    <Label Id="_labelToggleOverlay" Text="F1 - Toggle debug overlay" TextColor="#E8E8E8" />
    <Label Id="_labelWireframe" Text="F2 - Toggle wireframe" TextColor="#E8E8E8" />
    <Label Id="_labelBounds" Text="F3 - Toggle bounding boxes" TextColor="#E8E8E8" />
  </VerticalStackPanel>
</Project>
